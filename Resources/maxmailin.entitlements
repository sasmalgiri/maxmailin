<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Ad-hoc signed bundle: no App Sandbox so JMAP, file imports, attachment
      open/save, and Keychain access all work without entitlement plumbing.
      The Mac App Store path will need a sibling entitlements file with
      App Sandbox + the appropriate temporary-exception keys.
    -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
